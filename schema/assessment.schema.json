{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.n0t.space/schema/assessment.schema.json",
  "title": "PHLIPPED Assessment Item",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "question", "weight", "probes", "recommendation", "status", "version", "added", "modified"],
  "properties": {
    "id": { "type": "string", "pattern": "^PSPS-\\d{3}$" },
    "question": { "type": "string", "minLength": 1 },
    "weight": { "type": "integer", "minimum": 0, "maximum": 10 },
    "probes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^PHL-(T|M)-\\d{3}$" }
    },
    "recommendation": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["draft", "experimental", "stable", "deprecated"] },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "added": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "modified": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "deprecated": {
      "type": "object",
      "properties": {
        "superseded_by": { "type": "string" },
        "reason": { "type": "string" }
      }
    }
  }
}
