{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.n0t.space/schema/mitigation.schema.json",
  "title": "PHLIPPED Mitigation",
  "type": "object",
  "required": ["id", "name", "phase", "techniques", "cost_eur", "effort_hours", "description", "status", "version", "added", "modified"],
  "properties": {
    "id": { "type": "string", "pattern": "^PHL-M-\\d{3}$" },
    "name": { "type": "string" },
    "phase": { "type": "string", "enum": ["prevent", "respond"] },
    "techniques": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^PHL-T-\\d{3}$" }
    },
    "cost_eur": { "type": "integer", "minimum": 0 },
    "effort_hours": { "type": "integer", "minimum": 0 },
    "description": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["draft", "experimental", "stable", "deprecated"] },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "added": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "modified": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "deprecated": {
      "type": "object",
      "properties": {
        "superseded_by": { "type": "string" },
        "reason": { "type": "string" }
      }
    }
  }
}
