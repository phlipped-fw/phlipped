{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.n0t.space/schema/detection.schema.json",
  "title": "PHLIPPED Detection",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "techniques", "data_sources", "platform", "logic", "status", "version", "added", "modified"],
  "properties": {
    "id": { "type": "string", "pattern": "^PHL-D-\\d{3}$" },
    "name": { "type": "string" },
    "techniques": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^PHL-T-\\d{3}$" }
    },
    "data_sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^PHL-DS-\\d{2}$" }
    },
    "platform": { "type": "string", "enum": ["sigma", "wazuh"] },
    "logic": { "type": "string", "minLength": 1 },
    "false_positives": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["draft", "experimental", "stable", "deprecated"] },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "added": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "modified": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "deprecated": {
      "type": "object",
      "properties": {
        "superseded_by": { "type": "string" },
        "reason": { "type": "string" }
      }
    }
  }
}
