{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.n0t.space/schema/tactic.schema.json",
  "title": "PHLIPPED Tactic",
  "type": "object",
  "required": ["id", "name", "short_description", "order", "status", "version", "added", "modified"],
  "properties": {
    "id": { "type": "string", "pattern": "^PHL-TA-\\d{2}$" },
    "name": { "type": "string" },
    "short_description": { "type": "string" },
    "order": { "type": "integer", "minimum": 1 },
    "status": { "type": "string", "enum": ["draft", "experimental", "stable", "deprecated"] },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "added": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "modified": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  }
}
