{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.n0t.space/schema/data_source.schema.json",
  "title": "PHLIPPED Data Source",
  "type": "object",
  "required": ["id", "name", "kind", "description", "status", "version", "added", "modified"],
  "properties": {
    "id": { "type": "string", "pattern": "^PHL-DS-\\d{2}$" },
    "name": { "type": "string" },
    "kind": { "type": "string", "enum": ["PACS", "RF", "network", "host", "sensor"] },
    "description": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "experimental", "stable", "deprecated"] },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "added": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "modified": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "deprecated": {
      "type": "object",
      "properties": {
        "superseded_by": { "type": "string" },
        "reason": { "type": "string" }
      }
    }
  }
}
