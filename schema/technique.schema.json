{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.n0t.space/schema/technique.schema.json",
  "title": "PHLIPPED Technique",
  "type": "object",
  "required": ["id", "name", "category", "prerequisites", "tactics", "severity", "status", "version", "added", "modified"],
  "properties": {
    "id": { "type": "string", "pattern": "^PHL-T-[0-9]{3}$" },
    "name": { "type": "string" },
    "category": {
      "type": "string",
      "enum": ["rfid-nfc", "sub-ghz", "hid-injection", "drop-device", "rogue-ap", "ir", "ibutton", "usb-exfil"]
    },
    "prerequisites": {
      "type": "object",
      "required": ["physical_access", "time_seconds", "hardware", "skill_level"],
      "properties": {
        "physical_access": { "type": "string", "enum": ["touch", "proximity", "line-of-sight", "rf-range"] },
        "time_seconds": { "type": "integer", "minimum": 0 },
        "hardware": { "type": "array", "items": { "type": "string" } },
        "skill_level": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "tactics": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "data_sources": { "type": "array", "items": { "type": "string" } },
    "observables": { "type": "array", "items": { "type": "string" } },
    "known_tools": { "type": "array", "items": { "type": "string" } },
    "severity": { "type": "number", "minimum": 0, "maximum": 10 },
    "status": { "type": "string", "enum": ["draft", "experimental", "stable", "deprecated"] },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "added": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "modified": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "deprecated": {
      "type": "object",
      "properties": {
        "superseded_by": { "type": "string" },
        "reason": { "type": "string" }
      }
    }
  }
}
